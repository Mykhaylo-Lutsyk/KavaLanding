# ============================================================
# /.htaccess — Безпека, кешування, компресія для bestcoffe.shop
# ============================================================

# 1. БЛОКУВАННЯ ДОСТУПУ ДО ЧУТЛИВИХ ФАЙЛІВ І ДИРЕКТОРІЙ
# -------------------------------------------------------

# Повне блокування директорії .git
RedirectMatch 404 /\.git

# Заборона доступу до .env, Python-файлів, бекапів, логів, SQL-дампів, .md-інструкцій
<FilesMatch "\.(env|py|bak|swp|sql|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Блокуємо доступ до конкретних службових файлів
<FilesMatch "^(organize_photos\.py|AGENT_RULES\.md|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Заборона перегляду списку файлів директорій
Options -Indexes

# 2. ЗАГОЛОВКИ БЕЗПЕКИ
# -------------------------------------------------------
<IfModule mod_headers.c>
    # Запобігання вбудовуванню сайту в iframe (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Запобігання MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS-захист для старих браузерів
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Content Security Policy (підтримує Google Fonts, Font Awesome CDN, Google Analytics 4)
    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; \
        font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; \
        img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; \
        connect-src 'self' https://api.telegram.org https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; \
        frame-ancestors 'none';"
</IfModule>

# 3. GZIP / DEFLATE КОМПРЕСІЯ
# -------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. КЕШУВАННЯ СТАТИЧНИХ РЕСУРСІВ
# -------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# 5. CHARSET ЗА ЗАМОВЧУВАННЯМ
# -------------------------------------------------------
AddDefaultCharset UTF-8
